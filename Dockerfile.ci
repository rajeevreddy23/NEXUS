FROM eclipse-temurin:21-jre-alpine AS java-runtime
RUN addgroup -S nexus && adduser -S nexus -G nexus
WORKDIR /app
ADD https://repo.maven.apache.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/2.22.0/opentelemetry-javaagent-2.22.0.jar /app/otel-agent.jar
RUN chmod 644 /app/otel-agent.jar
USER nexus
ENTRYPOINT ["java","-javaagent:/app/otel-agent.jar","-XX:MaxRAMPercentage=65","-jar","/app/app.jar"]
FROM java-runtime AS backend
COPY --chown=nexus:nexus backend/target/backend-1.0.0.jar /app/app.jar
FROM java-runtime AS demo
COPY --chown=nexus:nexus demo/target/demo-1.0.0.jar /app/app.jar
FROM java-runtime AS workload
COPY --chown=nexus:nexus workload/target/workload-1.0.0.jar /app/app.jar
FROM node:24-alpine AS frontend
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --chown=node:node frontend/.next/standalone ./
COPY --chown=node:node frontend/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node","server.js"]
